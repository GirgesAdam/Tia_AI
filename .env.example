APP_NAME=Tia AI
ENVIRONMENT=staging
DEBUG=false
API_V1_PREFIX=/api/v1
DOCS_ENABLED=true
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:5432/postgres
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# LLM provider. OpenAI GPT-5.6 Luna is the recommended customer-facing default.
LLM_PROVIDER=openai
OPENAI_API_KEY=REPLACE_ME
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_REALTIME_MAX_RETRIES=0
LLM_REALTIME_CIRCUIT_BREAKER_COOLDOWN_SECONDS=120
LLM_MAX_OUTPUT_TOKENS=2048

# Optional Gemini configuration for staging/rollback. It is ignored when
# LLM_PROVIDER=openai.
GEMINI_API_KEY=
GEMINI_AGENT_MODEL=gemini-3.6-flash
GEMINI_AGENT_FALLBACK_MODEL=gemini-3.5-flash
GEMINI_AGENT_THINKING_LEVEL=low
GEMINI_ROUTER_MODEL=gemini-3.6-flash
GEMINI_ROUTER_FALLBACK_MODEL=gemini-3.5-flash
GEMINI_ROUTER_THINKING_LEVEL=low
GEMINI_FLOW_MODEL=gemini-3.6-flash
GEMINI_FLOW_FALLBACK_MODEL=gemini-3.5-flash
GEMINI_FLOW_THINKING_LEVEL=low
GEMINI_ONBOARDING_MODEL=gemini-3.7-flash
GEMINI_ONBOARDING_FALLBACK_MODEL=gemini-3.6-flash
GEMINI_ONBOARDING_THINKING_LEVEL=medium
GEMINI_ONBOARDING_MAX_OUTPUT_TOKENS=8192
GEMINI_UTILITY_MODEL=gemini-3.5-flash-lite
GEMINI_UTILITY_THINKING_LEVEL=minimal
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Semantic/workflow orchestration bounds
AGENT_UNIFIED_TURN_INTERPRETER_ENABLED=true
AGENT_SEMANTIC_ROUTER_ENABLED=true
AGENT_ROUTER_MAX_OUTPUT_TOKENS=1024
AGENT_ROUTER_HISTORY_MESSAGES=8
AGENT_FLOW_INTERPRETER_MAX_OUTPUT_TOKENS=1024
AGENT_FLOW_INTERPRETER_HISTORY_MESSAGES=8
AGENT_FLOW_TTL_HOURS=24

# Product-quality context bounds
AGENT_HISTORY_MESSAGES=24
AGENT_OPERATIONAL_CONTEXT_ITEMS=8
AGENT_OPERATIONAL_CONTEXT_MAX_CHARS=16000
AGENT_RECURSION_LIMIT=8
AGENT_MAX_TOOL_ROUNDS=2
AGENT_PREFETCH_READS_ENABLED=true
CHANNEL_DISPATCH_MAX_ATTEMPTS=5

# Accepts one origin, comma-separated origins, or a JSON array.
CORS_ORIGINS=http://localhost:3000

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

# Dedicated reporting capacity: analytics can become busy without starving booking.
ANALYTICS_DB_POOL_SIZE=2
ANALYTICS_DB_MAX_OVERFLOW=0
ANALYTICS_DB_POOL_TIMEOUT_SECONDS=3
ANALYTICS_STATEMENT_TIMEOUT_MS=10000
ANALYTICS_AGGREGATE_CACHE_TTL_SECONDS=5
ANALYTICS_AGGREGATE_CACHE_MAX_ENTRIES=256
ANALYTICS_EXPORT_MAX_ROWS=5000
ANALYTICS_EXPORT_MAX_BYTES=5000000

# Frontend (.env.local)
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
TIA_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_TIA_LEGAL_NAME=Tia AI
NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=privacy@example.com
NEXT_ALLOWED_DEV_ORIGINS=localhost
TIA_E2E_BASE_URL=http://127.0.0.1:3000

# Public recruiter/admin demo sandbox (backend)
DEMO_MODE=false
DEMO_ALLOW_EXTERNAL_DISPATCH=false
DEMO_AGENT_HOURLY_TURN_LIMIT=60

# Public recruiter/admin demo (frontend server + UI flag)
TIA_DEMO_ENABLED=false
NEXT_PUBLIC_TIA_DEMO_ENABLED=false
TIA_DEMO_EMAIL=demo@example.com
TIA_DEMO_PASSWORD=replace-with-a-strong-demo-password
