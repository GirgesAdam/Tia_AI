# Public hostname that will point to the Oracle VM, for example:
# automation.example.com
N8N_HOST=automation.example.com

# Current production FastAPI origin. Keep this as HTTPS and do not add a trailing slash.
TIA_API_BASE_URL=https://tia-api-production-54c5.up.railway.app

# Generate both values independently, for example with: openssl rand -hex 32
N8N_DB_PASSWORD=replace-with-a-long-random-password
N8N_ENCRYPTION_KEY=replace-with-a-long-random-key
