# Browser-visible Supabase Auth settings only.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only FastAPI origin. Do not prefix with NEXT_PUBLIC_.
TIA_API_URL=http://127.0.0.1:8000

# Public legal/privacy page settings.
# Use the real public-facing business/legal name when available.
NEXT_PUBLIC_TIA_LEGAL_NAME=Tia AI
# Recommended before publishing the Meta app. Use an inbox you actively monitor.
NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=privacy@YOUR_DOMAIN.com
