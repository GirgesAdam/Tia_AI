        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({status: (($json.messages?.[0]?.id || $json.id) ? 'sent' : 'failed'), provider_message_id: ($json.messages?.[0]?.id || $json.id || null), error: (($json.messages?.[0]?.id || $json.id) ? null : ($json.error?.message || $json.message || 'WhatsApp send failed in n8n')), retry_after_seconds: (($json.messages?.[0]?.id || $json.id) ? null : 30), metadata: {transport:'n8n', provider:'meta_cloud'}}) }}",
        "options": {
