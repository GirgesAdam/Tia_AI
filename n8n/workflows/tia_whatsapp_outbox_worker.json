        "jsCode": "const data = $json.body ?? $json;\nconst rows = Array.isArray(data) ? data : (data.dispatch_id ? [data] : []);\nreturn rows.filter(x => x?.dispatch_id && x?.external_user_id && x?.external_account_id).map(x => ({json:x}));"
      },
      "type": "n8n-nodes-base.code",
