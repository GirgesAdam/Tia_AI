{
  "name": "Tia v0.18 - Gmail Outbox Worker",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "seconds",
              "secondsInterval": 10
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -760,
        0
      ],
      "id": "65d3c6f4-8e17-4f3b-95a6-6c3cab8de001",
      "name": "Every 10 Seconds"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.TIA_API_BASE_URL || 'http://host.docker.internal:8000') + '/api/v1/channels/adapter/outbox/claim' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"limit\": 10\n}",
        "options": {
          "timeout": 30000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -520,
        0
      ],
      "id": "65d3c6f4-8e17-4f3b-95a6-6c3cab8de002",
      "name": "Tia Claim Gmail Outbox",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "const data = $json.body ?? $json;\nconst rows = Array.isArray(data) ? data : (data.dispatch_id ? [data] : []);\nreturn rows.filter(x => x?.dispatch_id && x?.channel === 'email' && x?.external_user_id).map(x => ({json:x}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -280,
        0
      ],
      "id": "65d3c6f4-8e17-4f3b-95a6-6c3cab8de003",
      "name": "Expand Gmail Dispatches"
    },
    {
      "parameters": {
        "sendTo": "={{ $json.external_user_id }}",
        "subject": "={{ $json.metadata?.email?.subject || 'رسالة من العيادة' }}",
        "message": "={{ $json.content }}",
        "options": {
          "appendAttribution": false
        }
      },
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        -20,
        0
      ],
      "id": "65d3c6f4-8e17-4f3b-95a6-6c3cab8de004",
      "name": "Gmail Send Message",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.TIA_API_BASE_URL || 'http://host.docker.internal:8000') + '/api/v1/channels/adapter/outbox/' + $('Expand Gmail Dispatches').item.json.dispatch_id + '/result' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({status: ($json.id ? 'sent' : 'failed'), provider_message_id: ($json.id || null), error: ($json.id ? null : ($json.error?.message || $json.message || 'Gmail send failed in n8n')), retry_after_seconds: ($json.id ? null : 60), metadata: {transport:'n8n', provider:'gmail', thread_id:($json.threadId || null)}}) }}",
        "options": {
          "timeout": 30000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        0
      ],
      "id": "65d3c6f4-8e17-4f3b-95a6-6c3cab8de005",
      "name": "Tia Record Gmail Result",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    }
  ],
  "connections": {
    "Every 10 Seconds": {
      "main": [
        [
          {
            "node": "Tia Claim Gmail Outbox",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Tia Claim Gmail Outbox": {
      "main": [
        [
          {
            "node": "Expand Gmail Dispatches",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Expand Gmail Dispatches": {
      "main": [
        [
          {
            "node": "Gmail Send Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Gmail Send Message": {
      "main": [
        [
          {
            "node": "Tia Record Gmail Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1",
    "timezone": "Africa/Cairo"
  },
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": []
}